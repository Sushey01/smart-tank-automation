{
  "name": "smart-tank-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Fault-tolerant NoSQL telemetry platform for one synthetic home water tank.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "server": "node src/server.js",
    "simulator": "node src/simulator.js",
    "seed": "node src/seed.js",
    "benchmark": "node src/benchmark.js",
    "smoke": "node src/smoke.js",
    "test": "node src/test.js",
